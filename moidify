#!/usr/bin/env bash
set -euo pipefail

APP_DIR="/opt/moidify"
DATA_DIR="/var/lib/moidify"
CONFIG_DIR="/etc/moidify"
SERVICE="moidify"
SERVICE_FILE="/etc/systemd/system/${SERVICE}.service"
SERVER_HOST="0.0.0.0"
SERVER_PORT=""
if [[ -f "$CONFIG_DIR/config.json" ]]; then
  SERVER_PORT=$(python3 -c "import json; print(json.load(open('$CONFIG_DIR/config.json')).get('port','8000'))" 2>/dev/null || echo "8000")
else
  SERVER_PORT="8000"
fi

RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'; CYAN='\033[0;36m'; BOLD='\033[1m'; NC='\033[0m'

info()  { echo -e "${CYAN}::${NC} $1"; }
ok()    { echo -e "${GREEN}ok${NC}  $1"; }
warn()  { echo -e "${YELLOW}!!${NC} $1"; }
err()   { echo -e "${RED}!!${NC} $1"; }

version() {
  if [[ -f "$APP_DIR/version.txt" ]]; then
    cat "$APP_DIR/version.txt"
  else
    echo "unknown"
  fi
}

# ─── Command registry ─────────────────────────────────────────────────────────
# Each command lives in its own file under moidify-commands/ and registers itself
# via cmd_register. The help menu and dispatcher are generated from this registry,
# so adding a command never requires editing the help text by hand.
declare -A CMD_DESC CMD_CAT CMD_USAGE

cmd_register() {
  local name="$1" cat="$2" desc="$3" usage="${4:-}"
  CMD_DESC["$name"]="$desc"
  CMD_CAT["$name"]="$cat"
  CMD_USAGE["$name"]="$usage"
}

# Locate the commands directory (works both from the repo and when installed)
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
if [[ -d "$SCRIPT_DIR/moidify-commands" ]]; then
  COMMANDS_DIR="$SCRIPT_DIR/moidify-commands"
else
  COMMANDS_DIR="${MOIDIFY_COMMANDS_DIR:-/opt/moidify/moidify-commands}"
fi

if [[ -d "$COMMANDS_DIR" ]]; then
  for f in "$COMMANDS_DIR"/*.sh; do
    [[ -f "$f" ]] && source "$f"
  done
fi

url() {
  local ip port="${SERVER_PORT}"
  ip=$(ip route get 1 2>/dev/null | awk '{print $7}' || hostname -I 2>/dev/null | awk '{print $1}' || echo "localhost")
  echo "http://${ip}:${port}"
}

show_config() {
  if [[ ! -f "$CONFIG_DIR/config.json" ]]; then
    err "Config file not found at $CONFIG_DIR/config.json"
    exit 1
  fi
  echo -e "${BOLD}Configuration:${NC}"
  echo "  Config file: $CONFIG_DIR/config.json"
  echo "  Data dir:    $DATA_DIR"
  echo "  App dir:     $APP_DIR"
  # Use Python to pretty-print JSON config
  python3 -c "
import json
with open('$CONFIG_DIR/config.json') as f:
    cfg = json.load(f)
for k, v in cfg.items():
    print(f'  {k}: {v}')
" 2>/dev/null || cat "$CONFIG_DIR/config.json"
  echo ""
  echo -e "${YELLOW}URL:${NC} $(url)"
}

# ─── Auto-generated help ──────────────────────────────────────────────────────
help() {
  local app_ver
  app_ver=$(version 2>/dev/null || echo "?")
  echo -e "${BOLD}Moidify v${app_ver}${NC} — Self-hosted music server"
  echo ""
  echo -e "${BOLD}Usage:${NC}"
  echo -e "  moidify ${CYAN}<command>${NC} [options]"
  echo ""

  # Print commands grouped by category. Known categories are listed first in a
  # preferred order; any new category a command registers is appended automatically
  # so the help menu never needs manual editing when a command is added.
  local known_cats="Service Info Import Maintenance"
  local cats="$known_cats"
  local name desc usage cat
  for name in "${!CMD_CAT[@]}"; do
    local c="${CMD_CAT[$name]}"
    if [[ " $cats " != *" $c "* ]]; then
      cats="$cats $c"
    fi
  done
  for cat in $cats; do
    local printed_cat=0
    for name in "${!CMD_DESC[@]}"; do
      if [[ "${CMD_CAT[$name]}" == "$cat" ]]; then
        if [[ $printed_cat -eq 0 ]]; then
          echo -e "${BOLD}${cat} commands:${NC}"
          printed_cat=1
        fi
        desc="${CMD_DESC[$name]:-}"
        usage="${CMD_USAGE[$name]:-}"
        if [[ -n "$usage" ]]; then
          printf "  ${GREEN}%-12s${NC} %s\n" "$name" "$desc"
          printf "               ${YELLOW}%s${NC}\n" "$usage"
        else
          printf "  ${GREEN}%-12s${NC} %s\n" "$name" "$desc"
        fi
      fi
    done
    [[ $printed_cat -eq 1 ]] && echo ""
  done

  # Lines that are not direct commands (options, examples, usage)
  echo -e "${BOLD}Options:${NC}"
  echo -e "  ${GREEN}-h, --help${NC}     Show this help"
  echo -e "  ${GREEN}-v, --version${NC}  Show version"
  echo ""
  echo -e "${BOLD}Examples:${NC}"
  echo -e "  moidify start"
  echo -e "  moidify logs"
  echo -e "  moidify config"
  echo -e "  moidify download ${YELLOW}<url>${NC}"
  echo -e "  moidify download ${YELLOW}--format flac <url>${NC}"
  echo -e "  moidify rescan"
  echo -e "  moidify rescan ${YELLOW}--clean${NC}"
  echo -e "  moidify reset-password"
}

# ─── Dispatch ─────────────────────────────────────────────────────────────────
case "${1:-}" in
  -h|--help|-help)
    help
    exit 0
    ;;
  -v|--version|version)
    echo "Moidify $(version)"
    exit 0
    ;;
  "")
    err "No command specified."
    echo ""
    help
    exit 1
    ;;
  *)
    if [[ -n "${CMD_DESC[$1]:-}" ]]; then
      handler="cmd_${1//-/_}"
      if declare -f "$handler" >/dev/null; then
        "$handler" "${@:2}"
      else
        err "Command '$1' is registered but has no handler implementation."
        exit 1
      fi
    else
      err "Unknown command: $1"
      echo ""
      help
      exit 1
    fi
    ;;
esac
